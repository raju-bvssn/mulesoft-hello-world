		{
			"name": "Load Testing",
			"item": [
				{
					"name": "Multiple Requests (Sequential)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is correct\", function () {",
									"    pm.expect(pm.response.text()).to.equal(\"Hello World from MuleSoft!\");",
									"});",
									"",
									"// Collect response times for analysis",
									"if (!pm.collectionVariables.get(\"responseTimes\")) {",
									"    pm.collectionVariables.set(\"responseTimes\", JSON.stringify([]));",
									"}",
									"",
									"let times = JSON.parse(pm.collectionVariables.get(\"responseTimes\"));",
									"times.push(pm.response.responseTime);",
									"pm.collectionVariables.set(\"responseTimes\", JSON.stringify(times));",
									"",
									"// Calculate statistics after 10 requests",
									"if (times.length >= 10) {",
									"    let avg = times.reduce((a, b) => a + b, 0) / times.length;",
									"    let min = Math.min(...times);",
									"    let max = Math.max(...times);",
									"    ",
									"    console.log(\"=== Response Time Statistics ===\");",
									"    console.log(\"Requests: \" + times.length);",
									"    console.log(\"Average: \" + avg.toFixed(2) + \"ms\");",
									"    console.log(\"Min: \" + min + \"ms\");",
									"    console.log(\"Max: \" + max + \"ms\");",
									"    ",
									"    // Reset for next batch",
									"    pm.collectionVariables.set(\"responseTimes\", JSON.stringify([]));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/hello",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"hello"
							]
						},
						"description": "Use Postman Collection Runner to execute this request multiple times.\n\n**How to use:**\n1. Click \"Run\" button in Postman\n2. Set iterations (e.g., 100)\n3. Optionally add delay between requests\n4. Click \"Run MuleSoft Hello World API\"\n\n**Expected Results:**\n- All requests should return 200 OK\n- Response time should be consistent"
					},
					"response": []
				}
			],
			"description": "Requests designed for load testing using Postman Collection Runner."
		},
